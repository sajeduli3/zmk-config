/ {
    /*
     * Minimal dummy KScan.
     * We are not testing the keyboard matrix yet.
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        row-gpios =
            <&gpio0 6 GPIO_ACTIVE_HIGH>,
            <&gpio0 8 GPIO_ACTIVE_HIGH>,
            <&gpio0 10 GPIO_ACTIVE_HIGH>;

        col-gpios =
            <&gpio0 24 GPIO_ACTIVE_HIGH>,
            <&gpio1 0 GPIO_ACTIVE_HIGH>,
            <&gpio0 11 GPIO_ACTIVE_HIGH>;

        diode-direction = "col2row";
    };

    chosen {
        zmk,kscan = &kscan0;
        zephyr,display = &oled;
    };
};

/*
 * Nice!Nano standard I2C:
 * P0.17 = SDA
 * P0.20 = SCL
 */
&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;

        width = <128>;
        height = <32>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;

        segment-remap;
        com-invdir;
        com-sequential;

        prechargep = <0x22>;
    };
};
